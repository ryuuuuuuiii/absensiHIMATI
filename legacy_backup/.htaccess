# Security
Options -Indexes
ServerSignature Off

# PHP Settings
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 12M
    php_value max_execution_time 60
    php_flag display_errors off
</IfModule>

# Prevent access to sensitive files
<FilesMatch "\.(sql|md|json|log|env)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Prevent access to config directory
<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Block access to config, includes, sql directories
    RewriteRule ^config/ - [F,L]
    RewriteRule ^includes/ - [F,L]
    RewriteRule ^sql/ - [F,L]
    RewriteRule ^google-apps-script/ - [F,L]
    
    # Redirect root to public rapat page
    RewriteRule ^$ rapat/index.php [L]
</IfModule>

# Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType text/css "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json
</IfModule>
